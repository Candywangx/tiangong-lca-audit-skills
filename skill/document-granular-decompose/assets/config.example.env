# Existing credentials; export into the standalone client's environment.
UNSTRUCTURED_AUTH_TOKEN=replace_with_fastapi_bearer_token
# Service root defaults to advanced parse; known full endpoints are also accepted.
UNSTRUCTURED_API_BASE_URL=https://your-unstructured-host:7770
# Optional independent image-description routing, used only for image modes.
# Omit to use service defaults; parsing tier is a separate CLI option.
# UNSTRUCTURED_PROVIDER=vllm
# UNSTRUCTURED_MODEL=Qwen/Qwen3.5-122B-A10B-FP8
