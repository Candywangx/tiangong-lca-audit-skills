{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TianGong model process audit evidence index",
  "type": "object",
  "required": ["schema_version", "audit_scope", "process_audits"],
  "properties": {
    "schema_version": {"const": "tiangong-audit-model-process-audits-v1"},
    "audit_scope": {"enum": ["full-lca-semantic-review", "partial"]},
    "process_audits": {"type": "array", "items": {"$ref": "#/$defs/process_audit"}},
    "node_roles": {"type": "array", "items": {"$ref": "#/$defs/node_role"}}
  },
  "additionalProperties": false,
  "$defs": {
    "refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "process_audit": {
      "type": "object",
      "required": ["process_id", "version", "snapshot_path", "snapshot_sha256"],
      "properties": {
        "process_id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "snapshot_path": {"type": "string", "minLength": 1},
        "snapshot_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "report_path": {"type": "string", "minLength": 1},
        "context_path": {"type": "string", "minLength": 1},
        "reference_unit": {
          "type": "object",
          "required": ["unit", "evidence_refs"],
          "properties": {
            "unit": {"type": "string", "minLength": 1},
            "evidence_refs": {"$ref": "#/$defs/refs"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "node_role": {
      "type": "object",
      "required": ["instance_id", "is_key", "reason", "evidence_refs"],
      "properties": {
        "instance_id": {"type": "string", "minLength": 1},
        "is_key": {"type": "boolean"},
        "reason": {"type": "string", "minLength": 1},
        "evidence_refs": {"$ref": "#/$defs/refs"}
      },
      "additionalProperties": false
    }
  }
}
